{% comment %}
  Plain paragraphs. HTML in the data file (links, emphasis) is rendered as-is.
{% endcomment %}

<div class="cv-entry">
  <div class="cv-entry-meta"></div>
  <div class="cv-entry-body cv-prose">
    {% for content in entry.contents %}
      <p>{{ content }}</p>
    {% endfor %}
  </div>
</div>
