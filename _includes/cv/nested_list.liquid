{% comment %}
  Grouped items (e.g. research interests): the group name heads the right-hand
  column so long titles are free to wrap.
{% endcomment %}

<div class="cv-entries">
  {% for content in entry.contents %}
    <div class="cv-entry">
      <div class="cv-entry-meta"></div>
      <div class="cv-entry-body">
        {% if content.title %}<h3>{{ content.title }}</h3>{% endif %}
        {% if content.items %}
          <ul class="cv-list">
            {% for subitem in content.items %}
              <li>{{ subitem }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>
