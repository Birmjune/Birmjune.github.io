{% comment %}
  Entries with a year in the left column and the details on the right, matching
  the two-column rhythm of the homepage sections.
{% endcomment %}

<div class="cv-entries">
  {% for content in entry.contents %}
    <div class="cv-entry">
      <div class="cv-entry-meta">
        {% if content.year %}<span class="cv-entry-year">{{ content.year }}</span>{% endif %}
        {% if content.location %}<span class="cv-entry-location">{{ content.location }}</span>{% endif %}
      </div>

      <div class="cv-entry-body">
        {% if content.title %}<h3>{{ content.title }}</h3>{% endif %}
        {% if content.institution %}<p class="cv-entry-org">{{ content.institution }}</p>{% endif %}
        {% if content.department %}<p class="cv-entry-org">{{ content.department }}</p>{% endif %}

        {% assign bullets = content.description | default: content.items %}
        {% if bullets %}
          <ul class="cv-list">
            {% for item in bullets %}
              <li>
                {% if item.contents %}
                  <span class="cv-list-title">{{ item.title }}</span>
                  <ul class="cv-list">
                    {% for subitem in item.contents %}
                      <li>{{ subitem }}</li>
                    {% endfor %}
                  </ul>
                {% else %}
                  {{ item }}
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if content.linkitems %}
          <div class="cv-links">
            {% for item in content.linkitems %}
              {% if item.link %}
                <a href="{{ item.link }}" target="_blank" rel="noopener noreferrer">{{ item.linkname | default: 'doc' }}</a>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>
