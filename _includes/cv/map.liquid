{% comment %}
  Name/value pairs (skills, contact details) on the same two-column grid.
{% endcomment %}

<dl class="cv-entries cv-map">
  {% for content in entry.contents %}
    <div class="cv-entry">
      <dt class="cv-entry-meta">{{ content.name }}</dt>
      <dd class="cv-entry-body">
        {% if content.value %}{{ content.value }}{% endif %}
        {% if content.links %}
          <div class="cv-links">
            {% for item in content.links %}
              {% if item.link %}
                <a href="{{ item.link }}" target="_blank" rel="noopener noreferrer">{{ item.name | default: 'doc' }}</a>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </dd>
    </div>
  {% endfor %}
</dl>
