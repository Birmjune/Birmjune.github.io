<script
  src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"
  integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4="
  crossorigin="anonymous"
></script>
<script src="{{ '/assets/js/bootstrap.bundle.min.js' | relative_url | bust_file_cache }}"></script>

{% if page.toc and page.toc.sidebar %}
  <script defer src="{{ '/assets/js/bootstrap-toc.min.js' | relative_url | bust_file_cache }}"></script>
  <script>
    // bootstrap-toc auto-builds every nav[data-toggle="toc"] on jQuery ready, so the
    // nav is marked up in the layout and we must NOT call Toc.init() ourselves --
    // doing both renders the entry list twice. Scrollspy waits for window load so the
    // links already exist.
    window.addEventListener("load", function () {
      $("body").scrollspy({ target: "#toc-sidebar", offset: 100 });
    });
  </script>
{% endif %}

{% if site.back_to_top %}
  <script src="{{ '/assets/js/vanilla-back-to-top.min.js' | relative_url | bust_file_cache }}"></script>
  <script>addBackToTop();</script>
{% endif %}
