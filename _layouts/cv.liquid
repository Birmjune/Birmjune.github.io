---
layout: default
---

{% assign display_name = site.first_name | append: ' ' | append: site.last_name | strip %}
{% assign general = site.data.cv | where: 'title', 'General Information' | first %}
{% for c in general.contents %}
  {% if c.name == 'Location' %}{% assign cv_location = c.value %}{% endif %}
  {% if c.name == 'Email' %}{% assign cv_email = c.value %}{% endif %}
{% endfor %}

<div class="cv-landing">
  <header class="cv-hero">
    <p class="cv-kicker">Curriculum vitae</p>
    <h1>{{ display_name }}</h1>
    {% if page.description %}<p class="cv-subtitle">{{ page.description }}</p>{% endif %}

    {% if cv_location or cv_email %}
      <div class="cv-meta">
        {% if cv_location %}<span>{{ cv_location }}</span>{% endif %}
        {% if cv_email %}<a href="mailto:{{ cv_email }}">{{ cv_email }}</a>{% endif %}
      </div>
    {% endif %}

    <div class="cv-actions">
      {% if page.cv_pdf %}
        <a class="cv-action cv-action-primary" href="{{ page.cv_pdf | relative_url }}" target="_blank" rel="noopener noreferrer">Download PDF</a>
      {% endif %}
      {% if site.data.socials.github_username %}
        <a class="cv-action" href="https://github.com/{{ site.data.socials.github_username }}" target="_blank" rel="noopener noreferrer">GitHub</a>
      {% endif %}
    </div>
  </header>

  {% for entry in site.data.cv %}
    {% unless entry.title == 'General Information' %}
      <section class="cv-section">
        <a class="anchor" id="{{ entry.title | slugify }}"></a>
        <div class="cv-section-heading">
          <p class="cv-section-label">{{ entry.label }}</p>
          <h2>{{ entry.title }}</h2>
        </div>
        <div class="cv-section-body">
          {% case entry.type %}
            {% when 'map' %}
              {% include cv/map.liquid %}
            {% when 'list' %}
              {% include cv/list.liquid %}
            {% when 'nested_list' %}
              {% include cv/nested_list.liquid %}
            {% when 'time_table' %}
              {% include cv/time_table.liquid %}
          {% endcase %}
        </div>
      </section>
    {% endunless %}
  {% endfor %}
</div>
